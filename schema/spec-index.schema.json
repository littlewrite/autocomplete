{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autocomplete:spec-index:schema:1",
  "title": "Completion spec asset index",
  "type": "object",
  "required": ["schemaVersion", "commands"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "commands": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "versions": { "type": "array", "items": { "$ref": "#/$defs/versionEntry" } }
      },
      "additionalProperties": false
    },
    "versionEntry": {
      "type": "object",
      "required": ["version", "file"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
      },
      "additionalProperties": false
    }
  }
}
