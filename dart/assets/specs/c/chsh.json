{
  "schemaVersion": 1,
  "name": "chsh",
  "description": "Change your login shell",
  "options": [
    {
      "name": [
        "-s",
        "--shell"
      ],
      "description": "Specify login shell",
      "args": {
        "name": "shell",
        "generators": {
          "script": [
            "chsh",
            "-l"
          ],
          "postProcess": {
            "handler": "manual.src_chsh.spec.options_0_.args.generators.postprocess",
            "version": 1
          }
        }
      }
    },
    {
      "name": [
        "-l",
        "--list-shells"
      ],
      "description": "Print list of shells and exit"
    },
    {
      "name": [
        "-u",
        "-h",
        "--help"
      ],
      "description": "Print help message and exit"
    },
    {
      "name": [
        "-v",
        "--version"
      ],
      "description": "Print version and exit"
    }
  ],
  "args": {
    "name": "username",
    "description": "Target user",
    "isOptional": true
  }
}
