{
  "schemaVersion": 1,
  "name": "degit",
  "description": "Straightforward project scaffolding",
  "args": [
    {
      "name": "user/repo",
      "generators": {
        "trigger": {
          "handler": "manual.src_degit.spec.args_0_.generators.trigger",
          "version": 1
        },
        "custom": {
          "handler": "manual.src_degit.spec.args_0_.generators.custom",
          "version": 1
        }
      }
    },
    {
      "name": "location",
      "isOptional": true,
      "template": "folders",
      "suggestCurrentToken": true
    }
  ],
  "options": [
    {
      "name": "--help",
      "description": "Print help"
    },
    {
      "name": [
        "-f",
        "--force"
      ],
      "description": "Overwrite existing files"
    },
    {
      "name": [
        "-c",
        "--cache"
      ],
      "description": "Use a cache"
    },
    {
      "name": [
        "-v",
        "--verbose"
      ],
      "description": "Be verbose?"
    },
    {
      "name": [
        "-m",
        "--mode"
      ],
      "description": "Clone mode",
      "args": {
        "name": "mode",
        "suggestions": [
          "git",
          "tar"
        ]
      }
    }
  ]
}
